#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

ynh_abort_if_errors

get__remote_password() {
    echo ""
}

get__local_imap_password() {
    echo ""
}

set__target_user() {
    save_runtime_settings
    ynh_print_info "Target user updated to $target_user."
}

set__remote_password() {
    if [ -z "${remote_password:-}" ]; then
        ynh_print_info "Remote IMAP password unchanged."
        return 0
    fi

    store_password_credential "$remote_credential_name" "$remote_password"
    ynh_print_info "Remote IMAP password updated."
}

set__local_imap_password() {
    if [ -z "${local_imap_password:-}" ]; then
        ynh_print_info "Local IMAP password unchanged."
        return 0
    fi

    store_password_credential "$local_imap_credential_name" "$local_imap_password"
    ynh_print_info "Local IMAP password updated."
}

ynh_app_config_run "$1"

if [ "$1" = "apply" ]; then
    save_runtime_settings
    fix_data_dir_permissions
fi
